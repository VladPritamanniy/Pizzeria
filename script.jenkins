properties([disableConcurrentBuilds()])

pipeline {
    agent any
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub_vladprytamannyi')
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
    }
    stages {
        stage("docker login") {
            steps {
                echo "============== docker login =================="
                sh('sudo systemctl start docker || true')
                sh('docker login -u $DOCKERHUB_CREDENTIALS_USR -p $DOCKERHUB_CREDENTIALS_PSW')
            }
        }
        stage("docker build") {
            steps {
                echo " ============== start building image =================="
                sh('docker build -t vladprytamannyi/pizzeria-api:latest .')
                sh('docker build -t vladprytamannyi/pizzeria-ui:latest -f Pizzeria.UI/pizzeria-ui/Dockerfile Pizzeria.UI/pizzeria-ui')
                
            }
        }
        stage("docker push") {
            steps {
                echo " ============== start pushing image =================="
                sh('docker push vladprytamannyi/pizzeria-api:latest')
                sh('docker push vladprytamannyi/pizzeria-ui:latest')
            }
        }
    }
}
