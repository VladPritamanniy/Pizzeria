properties([disableConcurrentBuilds()])

pipeline {
    agent any
    options {
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
    }
    stages {
        stage("docker login") {
            steps {
                echo " ============== docker login =================="
                withCredentials([usernamePassword(credentialsId: 'dockerhub_vladprytamannyi', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
                    sh """
                    docker login -u $USERNAME -p $PASSWORD
                    """
                }
            }
        }
        stage("docker build") {
            steps {
                echo " ============== start building image =================="
                sh 'docker build -t vladprytamannyi/pizzeria-api:latest . '
                sh 'docker build -t vladprytamannyi/pizzeria-ui:latest -f Pizzeria.UI/pizzeria-ui/Dockerfile Pizzeria.UI/pizzeria-ui'
                
            }
        }
        stage("docker push") {
            steps {
                echo " ============== start pushing image =================="
                sh '''
                docker push vladprytamannyi/pizzeria-api:latest
                '''
                sh '''
                docker push vladprytamannyi/pizzeria-ui:latest
                '''
            }
        }
    }
}
